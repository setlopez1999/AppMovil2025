<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema principal de la app para MODO OSCURO -->
    <style name="Theme.SonrisaSaludable" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colores principales -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/primario</item>
        <item name="colorOnPrimary">@color/white</item> <!-- texto sobre primary en oscuro -->
        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Superficie -->
        <item name="colorSurface">@android:color/black</item> <!-- fondo oscuro -->
        <item name="colorOnSurface">@android:color/white</item>
        <!-- Otros -->
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Tema base opcional para Material3 -->
    <style name="Base.Theme.SonrisaSaludable" parent="Theme.Material3.DayNight.NoActionBar" />

</resources>
