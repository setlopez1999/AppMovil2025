<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff"
    android:padding="0dp">

    <LinearLayout
        android:id="@+id/profile_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header azul -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/subsecundario"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Foto de perfil -->
            <androidx.cardview.widget.CardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardCornerRadius="60dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivFotoDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/doctor1_default"
                    android:contentDescription="@string/fragment_p_profile_foto_doctor" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvTituloPerfilDoctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fragment_p_profile_mi_perfil"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <!-- Nombre del doctor -->
            <TextView
                android:id="@+id/tvNombreDoctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fragment_p_profile_nombre_demo"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <!-- Especialidad -->
            <TextView
                android:id="@+id/tvEspecialidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fragment_p_profile_especialidad_demo"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Wave decorativa -->
        <ImageView
            android:id="@+id/imgWaveProfile"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_marginTop="-20dp"
            android:scaleType="fitXY"
            android:src="@drawable/wavee"
            app:tint="@color/subsecundario"/>

        <!-- Información personal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fragment_p_profile_info_personal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginBottom="16dp"/>

            <!-- Tarjeta de información personal -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fragment_p_profile_cedula_label"
                            android:textSize="14sp"
                            android:textColor="#666"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvCedulaProfesional"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fragment_p_profile_cedula_demo"
                            android:textSize="14sp"
                            android:textColor="#333"
                            android:layout_marginLeft="8dp"/>
                    </LinearLayout>
                    <!-- Email -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fragment_p_profile_email_label"
                            android:textSize="14sp"
                            android:textColor="#666"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvEmailDoctor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fragment_p_profile_email_demo"
                            android:textSize="14sp"
                            android:textColor="#333"
                            android:layout_marginLeft="8dp"/>
                    </LinearLayout>
                    <!-- Teléfono -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fragment_p_profile_telefono_label"
                            android:textSize="14sp"
                            android:textColor="#666"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvTelefonoDoctor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fragment_p_profile_telefono_demo"
                            android:textSize="14sp"
                            android:textColor="#333"
                            android:layout_marginLeft="8dp"/>
                    </LinearLayout>

                    <!-- Botón editar perfil -->
                    <Button
                        android:id="@+id/btnEditarPerfilDoctor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_p_profile_editar_perfil"
                        android:textAllCaps="false"
                        android:background="@color/subsecundario"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="16dp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Sección de reseñas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header de reseñas con calificación promedio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/fragment_p_profile_resenas_pacientes"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvPromedioCalificacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_p_profile_calificacion_demo"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#ff6b35"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_p_profile_estrellas"
                        android:textSize="16sp"
                        android:textColor="#ff6b35"
                        android:layout_marginLeft="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_p_profile_num_resenas"
                        android:textSize="14sp"
                        android:textColor="#666"
                        android:layout_marginLeft="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Botón ver todas las reseñas -->
            <Button
                android:id="@+id/btnVerTodasResenas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fragment_p_profile_ver_todas_resenas"
                android:background="#28a745"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="30dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
